{
  "name": "codegraphics-hyperframes",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "./vendor.sh",
    "lint": "cd release-card && hyperframes lint",
    "check": "cd release-card && hyperframes check",
    "render": "cd release-card && hyperframes render",
    "shorts:render": "cd shorts-roots-of-capitalism && for d in build/*/; do (cd \"$d\" && hyperframes render --output \"../../renders/$(basename \"$d\").mp4\"); done",
    "shorts:build": "cd shorts-roots-of-capitalism && node build.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "gsap": "^3.15.0",
    "hyperframes": "0.8.221",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
